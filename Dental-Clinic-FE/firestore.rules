rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules cho notifications
    // Path: notifications/{userId}/items/{notificationId}
    // 
    // Lưu ý: Web app không dùng Firebase Auth, chỉ dùng JWT từ backend
    // userId trong path đã được validate từ backend JWT token
    // User chỉ có thể đọc notifications của chính họ (dựa trên userId trong path)
    
    match /notifications/{userId}/items/{notificationId} {
      // Cho phép đọc notifications (userId đã được validate từ backend JWT)
      allow read: if true;
      
      // Chỉ backend (Admin SDK) mới có quyền write
      // Client không thể write trực tiếp
      allow write: if false;
    }
    
    // Cho phép đọc toàn bộ collection notifications/{userId}/items
    match /notifications/{userId}/items {
      allow read: if true;
      allow write: if false;
    }
    
    // Deny tất cả các collection khác
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

